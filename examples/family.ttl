@prefix : <https://example.org/family#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Musician rdfs:subClassOf :Person .
:Composer rdfs:subClassOf :Musician .
:Parent owl:equivalentClass [ owl:intersectionOf (
    :Person [ a owl:Restriction; owl:onProperty :hasChild; owl:hasValue :wilhelm ]
) ] .
:hasChild a owl:ObjectProperty;
    rdfs:subPropertyOf :ancestorOf;
    owl:inverseOf :hasParent;
    rdfs:domain :Person; rdfs:range :Person .
:ancestorOf a owl:TransitiveProperty .
:hasSSN a owl:InverseFunctionalProperty .
:Person owl:disjointWith :Composition .
:johann a :Composer; :hasChild :wilhelm; :hasSSN :ssn1 .
:jsbach :hasSSN :ssn1 .
:wilhelm :hasChild :grandchild .
