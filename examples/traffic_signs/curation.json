{
  "schema_version": 1,
  "provenance": {
    "author": "Project-curated example taxonomy; created for this repository on 2026-09-10",
    "source_role": "The CSV supplies crosswalk associations only, not this hierarchy. Category assignments are explicit project choices, not national legal classifications.",
    "method": "Every distinct raw YOLO label was reviewed and assigned explicitly. The generator performs exact label lookup, never prefix inference. No disjointness or cross-country equivalence is asserted.",
    "unknown_policy": "A previously unseen YOLO label is assigned UnclassifiedSign until manually reviewed. No absence-based inference runs inside DLP.",
    "caveats": [
      "Broad categories group visual/functional families and do not establish enforceability or current sign applicability.",
      "Source labels, including hazard:include:down and Zone:30:end, are kept verbatim.",
      "Subtype relationships between YOLO labels are not inferred from punctuation.",
      "An end sign remains in its functional family and does not itself establish the currently applicable restriction."
    ]
  },
